{
  "name": "@zelnora/sign",
  "version": "0.1.0",
  "private": true,
  "description": "自社専用の電子契約システム",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "db:test:start": "./scripts/pg-test.sh start",
    "db:test:stop": "./scripts/pg-test.sh stop",
    "bootstrap-owner": "tsx --conditions=react-server scripts/bootstrap-owner.ts",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "test:e2e": "playwright test",
    "e2e:setup": "./scripts/dev-db.sh sign_e2e >/dev/null && rm -rf .data-e2e && DATABASE_URL=postgres://postgres@127.0.0.1:54329/sign_e2e AUTH_DRIVER=dev pnpm -s bootstrap-owner owner@example.com && DATABASE_URL=postgres://postgres@127.0.0.1:54329/sign_e2e pnpm -s seed"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-heading": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "asn1js": "^3.0.10",
    "mammoth": "^1.13.0",
    "next": "16.3.7",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.4.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "subset-font": "^2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "jszip": "^3.10.2",
    "pg": "^8.23.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
