# ============================================================
# 電子契約システム（apps/sign）の環境変数
# 本番（Vercel）では「Settings → Environment Variables」に設定する。
# シークレットは絶対にコミットしないこと。
# ============================================================

# --- アプリ ---
# 署名URLやメールに載せる公開URL（末尾スラッシュなし）
APP_URL=https://sign.example.jp

# --- データベース（Supabase の PostgreSQL） ---
# Supabase → Project Settings → Database → Connection string（Transaction pooler, port 6543 推奨）
DATABASE_URL=postgres://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5

# --- Supabase（管理者ログイン・多要素認証・ファイル保存） ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。ブラウザに出さないこと
SUPABASE_SERVICE_ROLE_KEY=
# local にすると確定版PDFを .data/documents に保存（開発用）
STORAGE_DRIVER=

# --- 秘密値（それぞれ `openssl rand -base64 32` で生成） ---
# 署名者セッションCookieの署名
SESSION_SECRET=
# ワンタイムパスワードのハッシュ用ペッパー
OTP_SECRET=
# 署名URL（トークン）を管理画面で再コピーするための暗号鍵（AES-256-GCM）
TOKEN_ENCRYPTION_KEY=

# --- メール（Resend） ---
# 未設定の場合は送信せず .data/outbox.jsonl に記録する（開発用）
RESEND_API_KEY=
# SPF・DKIM・DMARCを設定した独自ドメインの送信元
MAIL_FROM=電子契約 <no-reply@sign.example.jp>

# --- タイムスタンプ局（RFC 3161） ---
# 本番は認定タイムスタンプ事業者のURLを推奨。開発では無償TSA（例 https://freetsa.org/tsr）も可。
# "dev" にすると内蔵の開発用TSA（自己署名・証拠力なし）を使う。本番では使用不可。
TSA_URL=https://freetsa.org/tsr
TSA_USERNAME=
TSA_PASSWORD=
TSA_TIMEOUT_MS=5000

# --- 定期実行（/api/cron/run） ---
# Vercel Cron は Authorization: Bearer $CRON_SECRET を付けて呼び出す
CRON_SECRET=

# --- 開発用 ---
# dev にするとSupabase Authを使わない開発用ログイン（本番ビルドでは起動時にエラー）
AUTH_DRIVER=
# PDFに埋め込むフォントの場所（既定は node_modules/@expo-google-fonts/noto-sans-jp）
FONT_DIR=
# 開発用データ（ローカル保存・送信記録）の保存先
LOCAL_DATA_DIR=.data
