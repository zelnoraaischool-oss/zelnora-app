    { "id": "contract", "name": "契約手続き", "kind": "contract", "order": 3, "requiredFields": ["planId", "amount", "paymentMethod"], "defaultNextAction": { "title": "締結を確認する", "days": 3 }, "staleDays": 7, "probability": 80 },
    { "id": "won", "name": "契約", "kind": "won", "order": 4, "requiredFields": [], "defaultNextAction": { "title": "利用登録を確認する", "days": 3 }, "staleDays": 7, "probability": 95 },
